#!/bin/bash
# The dashboard's checks, on every commit that changes the dashboard.
#
# **Why a hook.** The page checks — nervis/tools/check.py and the node gates listed
# in nervis/tools/dashboard_gates.txt — used to run only inside
# tools/check_clean_clone.sh, which is slow and was not being run. On 12 September
# 2026 five of them had been failing for up to three days, behind commits whose own
# checks (ruff, mypy, pytest, "the page parses") had all passed. The owner asked for
# them to run automatically on every change; a commit is the moment every change
# here passes through, so this is where they run.
#
# **What it checks is what is being committed**, not the working tree. The staged
# snapshot is exported to a scratch directory and checked there: more than one
# session works in this checkout, and a check run against files another session is
# still editing would pass or fail on work that is not in the commit.
#
# It runs only when a commit touches the dashboard, its checks, chat's knowledge
# notes or this hook; any other commit goes straight through. About thirty seconds
# when it runs.
#
# **Except the secret scan, which every commit gets** (16 September 2026): the lines a
# commit adds are checked for keys, tokens and private keys, by shape and against this
# machine's own launcher secrets, in about a second (tools/check_secret_content.py). It
# names the file and line, never the secret.
#
# Enabled once per clone:   git config core.hooksPath tools/githooks
# Skipping it with `git commit --no-verify` is the owner's call, not a session's.
set -uo pipefail

root_for_scan="$(git rev-parse --show-toplevel)" || exit 1
if ! python3 "$root_for_scan/tools/check_secret_content.py"; then
  echo "Commit stopped by the secret scan."
  exit 1
fi

changed="$(git diff --cached --name-only)"
if ! printf '%s\n' "$changed" | grep -Eq '^(nervis/(index\.html|tools/|knowledge/|package(-lock)?\.json)|tools/(knowledge_check\.py|githooks/))'; then
  exit 0
fi

root="$(git rev-parse --show-toplevel)" || exit 1
scratch="$(mktemp -d "${TMPDIR:-/tmp}/nervis-dashboard-checks.XXXXXX")" || exit 1
# The scratch directory is this hook's own, made on the line above; removing it on
# the way out is tidying up after itself. The Clarvis link inside it is removed as a
# link — `rm` does not follow it into the real repository.
trap 'rm -rf -- "$scratch"' EXIT
snapshot="$scratch/$(basename "$root")"
mkdir "$snapshot" || exit 1
# GIT_INDEX_FILE is honoured here, so `git commit --only <paths>` exports exactly
# the index that commit is about to record.
git checkout-index --all --prefix="$snapshot/" || exit 1
if [ -d "$root/nervis/node_modules" ]; then
  ln -s "$root/nervis/node_modules" "$snapshot/nervis/node_modules"
fi
# The knowledge check reads Clarvis's own sources from the repository beside this
# one (`ROOT.parent / "clarvis"` in tools/knowledge_check.py), so the copy is given
# the same neighbour. Without it every Clarvis endpoint chat names reads as unserved.
if [ -d "$root/../clarvis" ]; then
  ln -s "$(cd "$root/../clarvis" && pwd)" "$scratch/clarvis"
fi

echo "The dashboard changed, so its checks run on what is being committed (about 30 s)…"
failed=()
passed=0
check() {
  local name="$1"
  shift
  if "$@" >"$scratch/last-check.log" 2>&1; then
    passed=$((passed + 1))
  else
    printf '  ✗ %s\n' "$name"
    # The end, because every check here prints its verdict last.
    tail -n 20 "$scratch/last-check.log" | sed 's/^/      /'
    failed+=("$name")
  fi
}

# **The same containment the clean-clone check uses, for the same reason.** These
# gates execute `index.html`'s inline script in Node's VM, so what is being
# committed runs here with the committer's own privileges; this hook ran them
# with bare `node`, which left the path taken on *every commit* the unprotected
# one (base review, 17 September 2026, finding 5). One policy, sourced from
# `tools/node_guard.sh`, so the two cannot drift apart.
. "$snapshot/tools/node_guard.sh"
node_guard "$snapshot/tools/no-network.sb"

cd "$snapshot/nervis" || exit 1
check "page checks (tools/check.py)" python3 tools/check.py
for gate in $(grep -Ev '^[[:space:]]*(#|$)' tools/dashboard_gates.txt); do
  check "dashboard $gate" "${NODE_GUARD[@]}" "tools/${gate}_check.js"
done
# Bare, and deliberately: this one proves the wrapper above actually contains,
# so it spawns its own child processes and makes its own network call — running
# it wrapped would deny it the capability its job is to test with.
check "dashboard sandbox" node tools/sandbox_check.js
cd "$snapshot" || exit 1
check "knowledge files" python3 tools/knowledge_check.py

if [ "${#failed[@]}" -gt 0 ]; then
  printf '\nCommit stopped: %d of %d dashboard checks failed.\n' "${#failed[@]}" "$((passed + ${#failed[@]}))"
  echo "Fix them, or ask the owner before committing with --no-verify."
  exit 1
fi
echo "All $passed dashboard checks passed."
