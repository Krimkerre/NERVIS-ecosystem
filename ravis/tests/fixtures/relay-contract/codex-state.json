{
  "contract": {
    "name": "codex-relay-contract",
    "version": 1,
    "specified": "2026-09-13",
    "state": "specified, not built",
    "owner": "RAVIS (M29)",
    "consumers": ["Clarvis (E-C9)", "NERVIS (M28)", "tools/run.py, the launcher"],
    "canonical_text": ["ECOSYSTEM_RUNBOOK.md §2.2", "RAVIS.md §15.1.2", "CLARVIS.md §5.5", "NERVIS.md §8"]
  },
  "route": {
    "method": "GET",
    "path": "/api/v1/codex",
    "who_may_read": "any caller, including anonymous and NERVIS's GET relay",
    "speed": "answered from an in-memory snapshot within about 50 ms; it never waits on the Codex process",
    "status": "always 200 while RAVIS is up",
    "content": "metadata only"
  },
  "state_precedence": "exactly one state; when several apply, the earlier row wins",
  "states": [
    {"state": "checking", "when": "Before the first check after startup", "shown_as": "checking…"},
    {
      "state": "not_installed",
      "when": "The configured path, the Homebrew link, doesn't resolve to a file",
      "shown_as": "not installed"
    },
    {
      "state": "not_available",
      "when": "Disabled; wrong signature or team; home inside ~/.codex or RAVIS's configuration folder; or the check failed",
      "shown_as": "not available, with the reason"
    },
    {
      "state": "untested_version",
      "when": "The installed sha256 is in neither the tested nor the accepted list; or strict rules are on and strict_rules is unproven",
      "shown_as": "paused — Codex needs re-testing"
    },
    {
      "state": "runtime_down",
      "when": "The app-server is restarting or failed to start",
      "shown_as": "Codex process restarting"
    },
    {
      "state": "signed_out",
      "when": "account is null, after an admin sign-out or no sign-in ever",
      "shown_as": "signed out"
    },
    {
      "state": "sign_in_expired",
      "when": "account is null after a sign-in RAVIS didn't end",
      "shown_as": "sign-in expired"
    },
    {
      "state": "account_changed",
      "when": "The account fingerprint differs from the confirmed one",
      "shown_as": "different account — confirm on the dashboard"
    },
    {
      "state": "quota_exhausted",
      "when": "Any of: rateLimitReachedType non-null; a window at usedPercent >= 100 with a future reset; individualLimit.remainingPercent <= 0; spendControlReached true. Credits alone never count",
      "shown_as": "allowance used up · resets 04:30"
    },
    {"state": "signed_in", "when": "Otherwise", "shown_as": "62% left · resets 04:30, or usage unknown"}
  ],
  "run_states": [
    "running",
    "waiting_on_you",
    "paused_unanswered",
    "paused_for_update",
    "completed_needs_review",
    "uncertain",
    "leftover",
    "clarvis_engine"
  ],
  "runs_rules": [
    "runs lists live agent sessions and Clarvis-engine project locks",
    "every caller gets since, the start time",
    "only named callers — any client or admin credential, including NERVIS's relay and the launcher — also get each Codex run's id and current or last turn_id; the owner Stop confirmation sends back id, project and turn_id",
    "project is the basename of the workspace root: no path, request text or command",
    "a Clarvis-engine lock has no Codex session, so its id and turn_id are null for named callers (derived)"
  ],
  "usage_rules": [
    "while any turn is active, account/rateLimits/updated notifications are merged sparsely (source: notification) and polling pauses",
    "when no turn is active, account/rateLimits/read every 15 minutes, plus one read 30 s after the last active turn ends",
    "unknown is never 0: known false means windows [] and no percentages",
    "stale is true after 30 minutes without a reading while idle",
    "remaining_percent = max(0, 100 - round(usedPercent)); labels come from windowDurationMins; the resetsAt unit is pinned by a fixture test"
  ],
  "capabilities": [
    {
      "id": "ravis.codex_runtime",
      "version": "1.0.0",
      "state": "available",
      "constraints": {
        "backend_id": "ravis/clarvis-codex",
        "roles": ["agent"],
        "state_endpoint": "/api/v1/codex",
        "relay": "/api/v1/agent-sessions"
      }
    },
    {
      "id": "ravis.agent_sessions",
      "version": "1.0.0",
      "state": "available",
      "constraints": {
        "backend_id": "ravis/clarvis-codex",
        "roles": ["agent"],
        "state_endpoint": "/api/v1/codex",
        "relay": "/api/v1/agent-sessions"
      }
    }
  ],
  "capabilities_rule": "declared available once M29 ships; never used as readiness checks",
