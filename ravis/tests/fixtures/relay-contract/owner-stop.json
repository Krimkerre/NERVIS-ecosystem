{
  "contract": {
    "name": "codex-relay-contract",
    "version": 1,
    "specified": "2026-09-13",
    "state": "specified, not built",
    "owner": "RAVIS (M29)",
    "consumers": ["Clarvis (E-C9)", "NERVIS (M28)", "tools/run.py, the launcher"],
    "canonical_text": ["ECOSYSTEM_RUNBOOK.md §2.2", "RAVIS.md §15.1.2", "CLARVIS.md §5.5", "NERVIS.md §8"]
  },
  "route": {
    "method": "POST",
    "path": "/api/v1/agent-sessions/{sid}/owner-stop",
    "router": "its own APIRouter with require_owner_stop_caller, never require_agent_client",
    "callers": "an admin credential whose application is in settings.agent_owner_stop_applications, default [\"owner_cli\", \"launcher\"]: admin.owner_cli for the menu bar through run.py, admin.launcher for NERVIS's control route; separate applications give separate rate limits and audit identities",
    "body": "{source: menu_bar | dashboard, confirm: {project, turn_id}}; source is informational and grants nothing",
    "confirm_rule": "confirm must equal the session's folder name and its current or last turn id, as GET /api/v1/codex runs[] lists them; otherwise 409 CONFIRMATION_MISMATCH, so a stale menu or page can't stop a different task and nobody can stop a task by id alone",
    "grants_nothing_else": "answering, approving, steering, starting, continuing, changing mode, settling, ending, reading events or transcripts and reissuing tokens all keep refusing admin, NERVIS and launcher credentials"
  },
  "what_it_does": [
    "under the session's action lock: session stopping, with stopped_by = source",
    "every open request is answered with its stop response and request.resolved {by: owner_stop} is emitted; later answers get 409 SESSION_STOPPING",
    "the end sequence for that task only: interrupt, background terminals, per-process kills by pid and start time, confirmation",
    "session stopped (paused, thread kept, work left for a Clarvis window to review and save), or leftover naming the processes"
  ],
