      {
        "name": "a missing or malformed key is not forwarded",
        "request": {
          "caller": "dashboard page",
          "method": "POST",
          "path": "/api/v1/ravis/codex/runs/as_01J9ZK4T6Q8M2V7R3N5B1C0D/stop",
          "headers": {
            "Content-Type": "application/json",
            "x-nervis-control": "<the page's control token>",
            "Idempotency-Key": "short"
          },
          "body": {"project": "add-utc-demo", "turn_id": "019a1c2e-8c4f-7a21-b5d3-3e6c9b7f2a41"}
        },
        "forwarded_request": null,
        "response": {
          "status": 400,
          "body": {
            "message": "The Stop request needs an Idempotency-Key of 16 to 128 letters, digits, - or _."
          }
        }
      }
    ],
    "dashboard": "each running row in the Codex card has Stop…; a confirm() first; the row shows stopping…, then stopped — open the project to review; a 403 names the missing admin key, a 409 mismatch says The task changed; refresh"
  },
  "windows": {"code_server": "win-code-server-7f3a2b", "desktop": "win-desktop-1c9e4d"}
