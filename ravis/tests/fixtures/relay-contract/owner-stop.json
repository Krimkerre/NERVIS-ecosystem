  "attached_windows": {
    "stream": [
      "session.state {state: stopping, stopped_by}",
      "request.resolved {request_id, by: owner_stop} for each open request",
      "session.state {state: stopped | leftover, stopped_by, processes}"
    ],
    "clarvis": "each attached window clears its questions, says \"Stopped from the menu bar.\" or \"Stopped from the dashboard.\", and settles as after its own Stop, one window claiming; a window attaching later sees \"This task was stopped from the dashboard at 01:40. Review and save its work?\""
  },
  "audit": "ravis.agent_session.owner_stopped {session_id, source, application_id}",
  "mep_event": "ravis.agent_session.state_changed with reason_code owner_stop; no project path in either",
  "security": "the launcher's two admin keys are 0600 files and NERVIS's control token is served to any local page load, so a program running as the owner could stop tasks: a denial of service only, since the route can't write, approve, answer or start",
  "launcher": {
    "command": "run.py codex stop <id> --project <name> --turn <turn_id>",
    "reads": ".run/ravis-owner.token",
    "sends": "source menu_bar, the confirmation and a fresh Idempotency-Key",
    "prints": "{\"state\": \"stopping\"}, never the key",
    "exit_codes": {
      "0": "stopping",
      "6": "RAVIS down",
      "8": "confirmation mismatch",
      "9": "not found or nothing running",
      "10": "refused"
    }
  },
  "nervis_route": {
    "method": "POST",
    "path": "/api/v1/ravis/codex/runs/{sid}/stop",
    "checks": [
      "NERVIS's control token (x-nervis-control), by its existing check",
      "sid matches ^as_[0-9A-Za-z]{10,40}$",
      "Idempotency-Key matches ^[A-Za-z0-9_-]{16,128}$"
    ],
    "forwards": "with NERVIS's RAVIS admin credential, source dashboard and the page's own Idempotency-Key, so a retried click is replayed rather than repeated; RAVIS's status and body come back unchanged",
    "configure_headers": "ravis_peer.configure gains a keyword-only headers argument, used only by this route; a key named authorization, in any case, raises ValueError",
    "examples": [
      {
        "name": "forwarded",
        "request": {
          "caller": "dashboard page",
          "method": "POST",
          "path": "/api/v1/ravis/codex/runs/as_01J9ZK4T6Q8M2V7R3N5B1C0D/stop",
          "headers": {
            "Content-Type": "application/json",
            "x-nervis-control": "<the page's control token>",
            "Idempotency-Key": "FIXTUREdashboardStopKey01"
          },
          "body": {"project": "add-utc-demo", "turn_id": "019a1c2e-8c4f-7a21-b5d3-3e6c9b7f2a41"}
        },
        "forwarded_request": {
          "caller": "admin.launcher",
          "method": "POST",
          "path": "/api/v1/agent-sessions/as_01J9ZK4T6Q8M2V7R3N5B1C0D/owner-stop",
          "headers": {"Content-Type": "application/json", "Idempotency-Key": "FIXTUREdashboardStopKey01"},
          "body": {
            "source": "dashboard",
            "confirm": {"project": "add-utc-demo", "turn_id": "019a1c2e-8c4f-7a21-b5d3-3e6c9b7f2a41"}
          }
        },
        "response": {"status": 202, "body": {"state": "stopping"}}
      },
      {
