{
  "contract": {
    "name": "codex-relay-contract",
    "version": 1,
    "specified": "2026-09-13",
    "state": "specified, not built",
    "owner": "RAVIS (M29)",
    "consumers": ["Clarvis (E-C9)", "NERVIS (M28)", "tools/run.py, the launcher"],
    "canonical_text": ["ECOSYSTEM_RUNBOOK.md §2.2", "RAVIS.md §15.1.2", "CLARVIS.md §5.5", "NERVIS.md §8"]
  },
  "route": {
    "method": "GET",
    "path": "/api/v1/agent-sessions/{sid}/events",
    "needs": ["client credential", "session token"],
    "query": {
      "window_id": "the attaching window",
      "host": "desktop | code-server",
      "after": "equivalent to Last-Event-ID"
    },
    "content_type": "text/event-stream"
  },
  "frames_text": "retry: 3000\n\nid: 1235\nevent: request.opened\ndata: {\"session_id\":\"as_01J9ZK4T6Q8M2V7R3N5B1C0D\",\"request\":{…RequestView…}}\n\n: heartbeat\n\n",
  "frame_rules": [
    "ids are per-session, monotonic integers",
    "a heartbeat comment every 15 s",
    "retry: 3000 is advertised",
    "one JSON data line per frame: session_id plus the event's fields"
  ],
  "connection_rules": {
    "without_a_cursor": "the stream begins with event snapshot, then live events",
    "with_a_cursor": "events after that id are replayed, then live events",
    "cursor_inside_the_kept_non_delta_range": "every non-delta event after it is replayed, with a deltas_skipped marker where deltas were evicted",
    "cursor_too_old": "409 EVENT_CURSOR_EXPIRED {oldest_event_id} before streaming; read the snapshot and reconnect with ?after=<snapshot.last_event_id>",
    "closing_a_stream": "never stops a task"
  },
  "replay_buffers": {
    "deltas": "agent.delta and command.output: the last 2,000, or 8 MB",
    "other_events": "kept for the session's life, capped at 20,000 or 32 MB, dropping the oldest item.started and usage.updated first",
    "snapshots": "include the last 200 item.completed events",
    "lifetime": "until 30 minutes after the session ends; never written to disk"
  },
  "attachment": {
    "panel_ping_seconds": 10,
    "presence_every_seconds": 20,
    "pings_lost_after_seconds": 25,
    "attached_while_presence_younger_than_seconds": 45,
    "rules": [
      "a window counts as attached only while its Clarvis panel is connected, not merely while its extension host lives",
      "when the pings stop, the host posts panel_connected false and closes the stream",
      "when they resume, the host posts panel_connected true at once and reopens the stream from its cursor, or a snapshot"
    ]
  },
