            "body": {"method": "browser"}
          },
          "response": {
            "status": 202,
            "body": {
              "sign_in": {
                "state": "waiting_for_browser",
                "auth_url": "https://auth.openai.com/oauth/authorize?fixture=1",
                "callback_port": 1455,
                "started_at": "2026-09-13T01:54:00Z",
                "expires_at": "2026-09-13T02:04:00Z"
              }
            }
          }
        },
        {
          "name": "already waiting: the same body",
