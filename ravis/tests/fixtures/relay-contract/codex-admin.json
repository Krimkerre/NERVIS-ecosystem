  "account_fingerprint": [
    "on sign-in RAVIS stores sha256(\"ravis-codex-account:\" + lowercase(email)); with a null email, the sha256 of the rate-limit read's accountId; otherwise a weak plan-only fingerprint, flagged on the card",
    "a different fingerprint is account_changed: new sessions and turns get 409 CODEX_NOT_READY, and the dashboard asks This is my account or Sign out",
    "a plan change is a notice only; this catches accidental swaps, not a determined local program"
  ],
  "reprove_rules": {
    "trigger": "the owner, from the menu bar only: NERVIS menu → Codex → Re-test the file rules… → a confirmation → run.py codex reprove",
    "credential": "admin credentials whose application is in settings.codex_reproof_applications, default [\"owner_cli\"]; the launcher mints it into .run/ravis-owner.token and never gives it to NERVIS",
    "where": "inside RAVIS's one Codex process, only while no Codex task is live, in two throwaway folders under ~/.local/share/ravis-codex-reproof/<n>/ with no git and no network, each holding a decoy key file",
    "k5a_no_model": "command/exec in each folder tries to read the decoy key file and to write outside the folder; both must be refused",
    "k5b_one_turn": "in folder A, with a thread open in folder B, one fixed prompt: run exactly four commands one at a time — read the decoy key file, write one line outside the folder, each once plainly and once asking for escalated permissions — at low effort, the default model, at most 12 steps and 5 minutes",
    "approvals": "RAVIS's re-test harness allows a command only when its text matches one of the four exactly and the folder is A, once; anything else is declined and the result is inconclusive. The harness answers only for thread ids it created, never for an agent session (a test pins it), and every answer is audited. This is the only place RAVIS answers an approval.",
    "results": {
      "proven": "every refusal held and the decoy's marker never appeared; records strict_rules_proven for this sha256",
      "failed": "a rule didn't hold; strict_rules stays unproven and D2 returns to the owner",
      "inconclusive": "Codex didn't follow the list or a cap was hit; stays unproven, and the owner may try again"
    },
    "audit": [
      "ravis.codex.reproof_started {application_id}",
      "ravis.codex.reproof_approval_answered {command_index}",
      "ravis.codex.reproof_finished {result}"
    ]
  },
  "calibration_route": "POST /api/v1/codex/calibration/runs exists only while RAVIS_CODEX_CALIBRATION=1 and takes the same owner credential as reprove; no NERVIS route reaches it",
  "nervis_control_routes": {
    "rule": "each checks NERVIS's control token (header x-nervis-control), then calls RAVIS with NERVIS's RAVIS admin credential (admin.launcher)",
    "routes": [
      {"nervis": "POST /api/v1/ravis/codex/sign-in", "ravis": "POST /api/v1/codex/sign-in"},
      {"nervis": "DELETE /api/v1/ravis/codex/sign-in", "ravis": "DELETE /api/v1/codex/sign-in"},
      {"nervis": "POST /api/v1/ravis/codex/sign-out", "ravis": "POST /api/v1/codex/sign-out"},
      {"nervis": "POST /api/v1/ravis/codex/account/confirm", "ravis": "POST /api/v1/codex/account/confirm"},
      {"nervis": "GET /api/v1/ravis/codex/version-check", "ravis": "GET /api/v1/codex/version-check"},
      {"nervis": "POST /api/v1/ravis/codex/accept-version", "ravis": "POST /api/v1/codex/accept-version"},
      {
        "nervis": "POST /api/v1/ravis/codex/runs/{sid}/stop",
        "ravis": "POST /api/v1/agent-sessions/{sid}/owner-stop (owner-stop.json)"
      }
    ],
    "never": "no NERVIS route reaches /api/v1/codex/reprove, the calibration route, or any other agent-session or project-lock route; reads of /api/v1/codex use the existing GET relay"
  },
  "launcher": {
    "codex sign-in": {
      "reads": ".run/ravis-admin.token",
      "does": "POST sign-in, then open the auth_url; prints the state, never the URL",
      "exit_codes": {
        "0": "started",
        "3": "already signed in",
        "4": "not installed or untested",
        "5": "port busy",
        "6": "RAVIS down",
        "7": "turn active"
      }
    },
    "codex cancel-sign-in": {"does": "DELETE sign-in"},
    "codex reprove": {
      "reads": ".run/ravis-owner.token",
      "does": "POST reprove with a fresh Idempotency-Key, then GET every 5 s for up to 6 minutes; prints the result word, never the key",
      "exit_codes": {
        "0": "proven",
        "6": "RAVIS down",
        "7": "a task is running",
        "10": "refused",
        "11": "failed",
        "12": "inconclusive"
      }
    }
  },
